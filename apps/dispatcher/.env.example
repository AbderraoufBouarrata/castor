# Postgres connection string
DATABASE_URL=postgresql://postgres@localhost:5432/castor
# Jobs run at once = ephemeral workers alive at once (0 to 3)
MAX_CONCURRENT=3
# Each phase lasts STEP..2xSTEP seconds
STEP_SECONDS=4
# Chance a job fails (0-1)
FAIL_RATE=0.2
# Seconds between queue checks
POLL_SECONDS=2
